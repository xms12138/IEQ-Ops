# IEQ-Ops environment template. Copy to `.env` and fill in. `.env` is gitignored.
# pydantic-settings loads these; see core/ config loader.

# ── LLM: DeepSeek (OpenAI-API-compatible) ─────────────────────────────────────
# Routing per ops/llm_routing.md. DeepSeek-V3 was retired upstream (2026-05-25);
# the API now exposes only the two models below.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # reasoning tier — #3 Planner, #7/#8 Reflector (V3 successor)
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash  # fast tier — Specialist decompose/grade/generate, Conversational; + dev-temp for local nodes
DEEPSEEK_MODEL=deepseek-v4-flash        # legacy default alias; prefer _PRO/_FLASH explicitly

# ── Postgres (LangGraph checkpointer + ticket server) ─────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ieqops
POSTGRES_USER=ieqops
POSTGRES_PASSWORD=changeme
# Full DSN used by the checkpointer (derived or set directly):
DATABASE_URL=postgresql://ieqops:changeme@localhost:5432/ieqops

# ── Qdrant (episodic/semantic memory + RAG vectors) ───────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── LangFuse (observability) ──────────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosted server secrets (docker-compose). Generate each with `openssl rand -hex 32`.
LANGFUSE_NEXTAUTH_SECRET=changeme-openssl-rand-hex-32
LANGFUSE_SALT=changeme-openssl-rand-hex-32

# ── InfluxDB (sensor time-series — Phase 5, simulator until then) ─────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=casa
INFLUXDB_BUCKET=ieq

# ── Q&A butler: history sampler (ops/sampler.py) ──────────────────────────────
SAMPLE_INTERVAL_SECONDS=300   # demo: lower to 10 to grow a CO2 trend quickly

# ── Q&A butler: cascade voice (STT→LLM→TTS) ───────────────────────────────────
VOICE_PROVIDER=mock           # mock (browser Web Speech, no key) | aliyun (百炼 Qwen3-TTS)
VOICE_API_KEY=                # legacy/reserved; aliyun uses DASHSCOPE_API_KEY below
# 阿里云百炼 (DashScope): Qwen3-TTS-Flash realtime streaming TTS + Paraformer English STT.
# Singapore (intl) endpoints — measured ~5 s faster than Beijing.
DASHSCOPE_API_KEY=            # sk-... from bailian.console.aliyun.com
DASHSCOPE_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime    # TTS realtime (Singapore)
DASHSCOPE_HTTP_URL=https://dashscope-intl.aliyuncs.com/api/v1            # STT Qwen3-ASR (Singapore)
TTS_MODEL=qwen3-tts-flash-realtime  # Qwen3-TTS flash, streaming realtime
TTS_VOICE=Jennifer            # 詹妮弗 — American-drama female lead
TTS_LANGUAGE=English          # qwen-tts language_type
ASR_MODEL=qwen3-asr-flash           # Qwen3-ASR (intl), batch file recognition via HTTP

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=dev          # dev | prod — dev uses simulator + fake actuators (log only)
LOG_LEVEL=INFO
