// arduino_secrets.h — copy this file to arduino_secrets.h, fill in your own
// three values, then flash. arduino_secrets.h is gitignored: never commit
// your real WiFi password.
//
// SECRET_BROKER = the Raspberry Pi's LAN IP. On the Pi run:  hostname -I
// The MKR1010 and the Pi MUST be on the same WiFi network.

#define SECRET_SSID   "your-wifi-ssid"
#define SECRET_PASS   "your-wifi-password"
#define SECRET_BROKER "192.168.1.xxx"
