# IEQ-Ops autonomous heartbeat — MainIncidentGraph scan + resume (systemd template).
# This is the always-on core (CLAUDE.md Principle #1): every 5 min it runs one
# monitor→…→action pass on the current readings, and every 1 min it resumes any thread
# whose 15-min verify window has elapsed. Without this unit nothing fires unattended.
#
# Needs Postgres (checkpointer + tickets) and Qdrant (RAG + memory); the After/Wants on
# them order boot but are best-effort — a scan that races a cold DB just fails and the
# next tick retries (APScheduler keeps the process alive), so Restart covers the rest.
# Adjust WorkingDirectory and the uv path to the deployment host (Pi: `which uv`). Install:
#   sudo cp ieq-scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ieq-scheduler
[Unit]
Description=IEQ-Ops autonomous heartbeat - incident scan + verify resume
After=network-online.target postgresql.service qdrant.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xms/projects/dissertation
EnvironmentFile=/home/xms/projects/dissertation/.env
ExecStart=/home/xms/.local/bin/uv run python -m ops.scheduler
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
