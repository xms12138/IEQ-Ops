# IEQ-Ops Q&A butler — FastAPI web (systemd template).
# Adjust WorkingDirectory and the uv path to the deployment host (e.g. on a Raspberry
# Pi: `which uv`). Install: copy to /etc/systemd/system/, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now ieq-web
# Also make sure the data stores auto-start on boot (belt-and-braces with Wants= below):
#   sudo systemctl enable postgresql qdrant
[Unit]
Description=IEQ-Ops Q&A butler - FastAPI web
# Needs Postgres (checkpointer + tickets + sensor history) and Qdrant (RAG + memory).
# Wants= (not just After=) so enabling this unit pulls the DBs up at boot even if they
# were never enabled standalone — closes the "postgresql didn't auto-start" single point.
After=network-online.target postgresql.service qdrant.service
Wants=network-online.target postgresql.service qdrant.service

[Service]
Type=simple
WorkingDirectory=/home/xms/projects/dissertation
EnvironmentFile=/home/xms/projects/dissertation/.env
ExecStart=/home/xms/.local/bin/uv run uvicorn frontend.api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
